<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.5" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
        <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.5.3" />
        <PackageReference Include="Pty.Net" Version="0.3.94-pre" />
        <PackageReference Include="System.Management.Automation" Version="7.5.3" />
        <PackageReference Include="UTF.Unknown" Version="2.6.0" />
    </ItemGroup>

    <Target Name="CopyPtyNativeFilesToPublishDir" AfterTargets="Publish">
        <ItemGroup>
            <PtyNativeFilesOs64 Include="$(OutputPath)os64\**\*.*" />
            <PtyNativeFilesOs86 Include="$(OutputPath)os86\**\*.*" />
        </ItemGroup>
        <MakeDir Directories="$(PublishDir)os64;$(PublishDir)os86" />
        <Copy SourceFiles="@(PtyNativeFilesOs64)" DestinationFiles="@(PtyNativeFilesOs64->'$(PublishDir)os64\%(RecursiveDir)%(Filename)%(Extension)')" />
        <Copy SourceFiles="@(PtyNativeFilesOs86)" DestinationFiles="@(PtyNativeFilesOs86->'$(PublishDir)os86\%(RecursiveDir)%(Filename)%(Extension)')" />
    </Target>
</Project>
